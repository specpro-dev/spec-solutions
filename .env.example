# Environment variables for Spec Solutions
# Copy this file to .env.local and fill in real values before running locally.
# NEVER commit .env.local to version control.

# ─── Resend ──────────────────────────────────────────────────────────────────
# Required for the contact form to deliver leads to your inbox.
# Get a free API key at https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The email address that receives contact form submissions.
# Must be from a domain you've verified in Resend, or use the onboarding address
# during testing.
CONTACT_TO_EMAIL=hello@nextintakedigital.com

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Your GA4 Measurement ID. Find it in GA4 > Admin > Data Streams.
# Prefix must be G- (not UA-).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Google Search Console ────────────────────────────────────────────────────
# The value of the <meta name="google-site-verification"> tag.
# Find it in Search Console > Settings > Ownership verification > HTML tag method.
# Leave blank until you have this — it won't break anything.
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Canonical domain used in sitemap.xml and Open Graph tags.
# No trailing slash. Must match your actual registered domain.
# WARNING: Wrong value here quietly hurts SEO — no build-time error will catch it.
NEXT_PUBLIC_SITE_URL=https://nextintakedigital.com
